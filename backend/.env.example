# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-aws-student-portal-2026-production-ready
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL on AWS RDS or local)
# Set DB_TYPE=postgres when connecting to Amazon RDS PostgreSQL
# If DB_TYPE=sqlite or connection fails, the system automatically uses local SQLite for seamless testing
DB_TYPE=sqlite
DATABASE_URL=postgresql://postgres:password@localhost:5432/student_portal
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=student_portal

# AWS Credentials and Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon S3 Configuration
AWS_S3_BUCKET=aws-student-submission-portal-bucket
# Set USE_LOCAL_STORAGE=true to test file uploads locally without an AWS account
USE_LOCAL_STORAGE=true

# Amazon CloudWatch Configuration
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/aws/student-portal
CLOUDWATCH_LOG_STREAM=api-server

# Admin Seed Account (Default Credentials for Initial Setup)
ADMIN_EMAIL=admin@portal.edu
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=System Administrator
