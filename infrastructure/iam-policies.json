{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3SubmissionStorageOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::aws-student-submission-portal-*",
        "arn:aws:s3:::aws-student-submission-portal-*/*"
      ]
    },
    {
      "Sid": "AllowCloudWatchLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/student-portal:*"
      ]
    }
  ]
}
